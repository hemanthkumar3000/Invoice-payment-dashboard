    TRUE(),
    ReconciledInvoices[Total_Paid] >= ReconciledInvoices[Invoice_Amount], "Paid",
    ReconciledInvoices[Total_Paid] > 0, "Partially Paid",
    "Unpaid"
)

Calculated Column: Aging Sort Order
Aging_Sort_Order = 
SWITCH(
    ReconciledInvoices[Aging_Bucket],
    "Current / Not Due", 1,
    "1-30 Days", 2,
    "31-60 Days", 3,
    "61-90 Days", 4,
    "90+ Days", 5,
    6
)
*/
